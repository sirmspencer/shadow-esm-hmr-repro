{
  "name": "shadow-esm-hmr-repro",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build:watch": "clojure -J-Dshadow.repro=esm-hmr -M -m shadow.cljs.devtools.cli watch app",
    "build:watch:local": "clojure -J-Dshadow.repro=esm-hmr -M:local -m shadow.cljs.devtools.cli watch app",
    "build:release": "clojure -J-Dshadow.repro=esm-hmr -M -m shadow.cljs.devtools.cli release app",
    "build:release:local": "clojure -J-Dshadow.repro=esm-hmr -M:local -m shadow.cljs.devtools.cli release app",
    "stop": "pkill -f 'shadow.repro=esm-hmr' || true",
    "clear-cache": "rm -rf .shadow-cljs public/js"
  },
  "devDependencies": {
    "playwright": "^1.58.2"
  },
  "dependencies": {
    "@ms/min-component-library": "file:../min-component-library"
  }
}
